---
import Section from './Section.astro';
import { faq } from '../data/content';
---
<Section id="faq" label="Вопросы" title="Частые вопросы">
  <div class="faq">
    {faq.map((f) => (
      <details class="faq__item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</Section>
<style>
  .faq { max-width: 48rem; }
  .faq__item { border-top: 1px solid rgb(0 0 0 / 0.2); }
  .faq__item:last-child { border-bottom: 1px solid rgb(0 0 0 / 0.2); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); min-height: 56px; padding-block: var(--space-4); cursor: pointer; list-style: none; font-size: var(--fs-body); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.5rem; line-height: 1; transition: transform var(--dur-hover) var(--ease-soft); }
  details[open] > summary::after { content: '−'; }
  .faq__item p { padding-bottom: var(--space-6); color: var(--color-text-muted); max-width: 40ch; }
</style>
