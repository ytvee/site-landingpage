---
interface Props {
  id: string;
  title: string;
  label?: string;
  tone?: 'default' | 'alt';
}
const { id, title, label, tone = 'default' } = Astro.props;
---
<section id={id} class={`section section--${tone}`} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section__head">
      {label && <p class="label">{label}</p>}
      <h2 id={`${id}-title`}>{title}</h2>
    </header>
    <slot />
  </div>
</section>
<style>
  .section { padding-block: var(--section-gap); }
  .section--alt { background: var(--color-bg-alt); }
  .section__head { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-12); }
</style>
