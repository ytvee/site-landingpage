---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  label?: string;
  title: string;
  text: string;
  facts: string[];
  image: ImageMetadata;
  alt: string;
  reverse?: boolean;
  tone?: 'default' | 'alt';
}
const { id, label, title, text, facts, image, alt, reverse = false, tone = 'default' } = Astro.props;
---
<section id={id} class={`split split--${tone}`} aria-labelledby={`${id}-title`}>
  <div class={`container split__grid${reverse ? ' split__grid--reverse' : ''}`}>
    <div class="split__text">
      {label && <p class="label">{label}</p>}
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="split__lead">{text}</p>
      <ul class="split__facts">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
    <Image class="split__img" src={image} alt={alt} widths={[500, 800, 1200]} sizes="(min-width: 900px) 58vw, 100vw" format="webp" loading="lazy" />
  </div>
</section>
<style>
  .split { padding-block: var(--section-gap); }
  .split--alt { background: var(--color-bg-alt); }
  .split__grid { display: grid; gap: var(--space-8); align-items: center; }
  .split__text { display: flex; flex-direction: column; gap: var(--space-4); }
  .split__lead { color: var(--color-text-muted); max-width: 36ch; }
  .split__facts { list-style: none; margin: var(--space-6) 0 0; padding: 0; font-size: var(--fs-body-sm); }
  .split__facts li { padding-block: var(--space-3); border-top: 1px solid rgb(0 0 0 / 0.2); }
  .split__facts li:last-child { border-bottom: 1px solid rgb(0 0 0 / 0.2); }
  .split__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 899px) { .split__img { order: -1; } }
  @media (min-width: 900px) {
    .split__grid { grid-template-columns: 5fr 7fr; gap: var(--space-16); }
    .split__grid--reverse { grid-template-columns: 7fr 5fr; }
    .split__grid--reverse .split__text { order: 2; }
  }
</style>
