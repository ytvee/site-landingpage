---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Metrika from '../components/Metrika.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Индексация включается только явно (боевая сборка). По умолчанию страница закрыта от индексации.
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#fcfbf9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CoffeeFy: кофейня на Фонтанке, 126, Санкт-Петербург" />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd url={canonical} image={ogImage} description={description} />
    <Metrika />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-source-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-nunito" preload={[{ weight: 400, style: 'normal' }]} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">К содержимому</a>
    <TopBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
