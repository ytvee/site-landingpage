---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Индексация включается только явно (боевая сборка). По умолчанию страница закрыта от индексации.
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="canonical" href={canonical} />
    <Font cssVariable="--font-source-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-nunito" preload={[{ weight: 400, style: 'normal' }]} />
  </head>
  <body>
    <slot />
  </body>
</html>
