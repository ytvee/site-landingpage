---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SplitSection from '../components/SplitSection.astro';
import Gallery from '../components/Gallery.astro';
import Booking from '../components/Booking.astro';
import Location from '../components/Location.astro';
import TelegramBlock from '../components/TelegramBlock.astro';
import Faq from '../components/Faq.astro';
import { workBlock, meetingsBlock } from '../data/content';
---

<BaseLayout
  title="CoffeeFy: кофейня на Фонтанке, 126"
  description="CoffeeFy: кофейня в Санкт-Петербурге на набережной реки Фонтанки, 126. Ежедневно с 9 до 22."
>
  <Hero />
  <SplitSection {...workBlock} />
  <SplitSection {...meetingsBlock} reverse tone="alt" />
  <Gallery />
  <Booking />
  <Location />
  <TelegramBlock />
  <Faq />
</BaseLayout>
